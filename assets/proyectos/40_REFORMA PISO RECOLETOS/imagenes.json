---
layout: null
---
{%- assign folder = "/assets/proyectos/40_REFORMA PISO RECOLETOS/" -%}
{%- assign files = site.static_files | sort: "name" -%}
{%- assign separator = "" -%}
[
{%- for file in files -%}
  {%- if file.path contains folder -%}
    {%- assign filename = file.path | remove_first: folder -%}
    {%- unless filename contains "/" -%}
      {{- separator -}}{{- filename | jsonify -}}
      {%- assign separator = "," -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
]
